[
  {
    "id": "refund-approval",
    "name": "Refund approval",
    "summary": "Decide whether a refund request is approved, escalated, denied or sent to fraud review.",
    "fit": "good",
    "fit_reasons": [
      "Decided hundreds of times a month",
      "Four clear outcomes",
      "Amount and timing thresholds are where general models slip",
      "A manager reviews escalations, so mistakes are catchable"
    ],
    "sample_inputs": [
      "Customer wants $45 back on a duplicate charge from two days ago, standard plan.",
      "An enterprise customer asks for $1,200 back on an annual plan bought last week.",
      "Someone says they never made a $89 purchase made 3 days ago and their card was stolen."
    ],
    "policy": {
      "decision_question": "What should we do with this refund request?",
      "question_key": "decision",
      "inputs": [
        {
          "key": "amount",
          "label": "Amount (USD)",
          "type": "float",
          "description": "Refund amount requested."
        },
        {
          "key": "days_since_purchase",
          "label": "Days since purchase",
          "type": "int",
          "description": ""
        },
        {
          "key": "plan",
          "label": "Plan",
          "type": "enum",
          "description": "",
          "values": [
            "free",
            "standard",
            "enterprise"
          ]
        },
        {
          "key": "fraud_signals",
          "label": "Fraud signals mentioned",
          "type": "bool",
          "description": "Chargeback threats, stolen card or account takeover language."
        },
        {
          "key": "reason",
          "label": "Reason given",
          "type": "text",
          "description": ""
        }
      ],
      "options": [
        {
          "key": "approve",
          "name": "Approve",
          "covers": [
            "$500 or less",
            "Within 30 days of purchase"
          ],
          "excludes": [
            "Anything mentioning fraud"
          ],
          "example": "A $40 refund for a duplicate charge two days ago."
        },
        {
          "key": "escalate",
          "name": "Escalate to a manager",
          "covers": [
            "Over $500",
            "Enterprise customers asking for more than $200"
          ],
          "excludes": [
            "Fraud claims"
          ],
          "example": "A $900 annual plan refund."
        },
        {
          "key": "deny",
          "name": "Deny",
          "covers": [
            "More than 30 days after purchase on non-enterprise plans"
          ],
          "excludes": [
            "Duplicate charges, which are always refunded"
          ],
          "example": "A refund asked for 80 days after buying."
        },
        {
          "key": "fraud_review",
          "name": "Fraud review",
          "covers": [
            "Any sign of stolen card, chargeback threat or account takeover"
          ],
          "excludes": [],
          "example": "I did not make this purchase."
        }
      ],
      "rules": [
        {
          "id": "R1",
          "text": "Any sign of fraud goes to fraud review.",
          "label": "fraud_review",
          "when": {
            "field": "fraud_signals",
            "op": "eq",
            "value": true
          }
        },
        {
          "id": "R2",
          "text": "Refunds over $500 are escalated to a manager.",
          "label": "escalate",
          "when": {
            "field": "amount",
            "op": "gt",
            "value": 500
          }
        },
        {
          "id": "R3",
          "text": "Refunds requested more than 30 days after purchase are denied.",
          "label": "deny",
          "when": {
            "field": "days_since_purchase",
            "op": "gt",
            "value": 30
          }
        }
      ]
    }
  },
  {
