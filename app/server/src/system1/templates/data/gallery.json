    "flagship": {
      "folder": "tallyfern",
      "eval_models": {
        "sys1": "sys1",
        "jev_policy": "jev_policy",
        "jev_labels": "jev_labels",
        "base": "base"
      },
      "model_label": "sys1 (Tallyfern triage)"
    }
  },
  {
    "id": "lead-routing",
    "name": "Inbound lead routing",
    "summary": "Send each new lead to the right sales team, nurture it or disqualify it.",
    "fit": "good",
    "fit_reasons": [
      "Many leads a day",
      "Few clear outcomes",
      "Company size and region rules are easy to state",
      "A bad route is cheap to fix"
    ],
    "sample_inputs": [
      "VP of Ops at a 2,400-person logistics company asks for a demo.",
      "A graduate student wants a free account for a thesis project.",
      "The owner of a 12-person design studio downloaded the pricing guide."
    ],
    "policy": {
      "decision_question": "Where should this lead go?",
      "question_key": "decision",
      "inputs": [
        {
          "key": "employees",
          "label": "Company size (employees)",
          "type": "int",
          "description": ""
        },
        {
          "key": "region",
          "label": "Region",
          "type": "enum",
          "description": "",
          "values": [
            "na",
            "emea",
            "apac",
            "other"
          ]
        },
        {
          "key": "is_student",
          "label": "Student or hobbyist",
          "type": "bool",
          "description": ""
        },
        {
          "key": "budget_stated",
          "label": "Budget stated",
          "type": "bool",
          "description": ""
        }
      ],
      "options": [
        {
          "key": "enterprise_team",
          "name": "Enterprise sales",
          "covers": [
            "1,000 or more employees"
          ],
          "excludes": [
            "Students"
          ],
          "example": ""
        },
        {
          "key": "mid_market_team",
          "name": "Mid-market sales",
          "covers": [
            "100 to 999 employees"
          ],
          "excludes": [],
          "example": ""
        },
        {
          "key": "nurture",
          "name": "Nurture",
          "covers": [
            "Under 100 employees with interest"
          ],
          "excludes": [],
          "example": ""
        },
        {
          "key": "disqualify",
          "name": "Disqualify",
          "covers": [
            "Students, hobbyists, competitors"
          ],
          "excludes": [],
          "example": ""
        }
      ],
      "rules": [
        {
          "id": "R1",
          "text": "Students and hobbyists are disqualified.",
          "label": "disqualify",
          "when": {
            "field": "is_student",
            "op": "eq",
            "value": true
          }
        },
        {
          "id": "R2",
          "text": "1,000 or more employees go to Enterprise sales.",
          "label": "enterprise_team",
          "when": {
            "field": "employees",
            "op": "gte",
            "value": 1000
          }
        },
        {
          "id": "R3",
          "text": "100 to 999 employees go to Mid-market sales.",
          "label": "mid_market_team",
          "when": {
            "field": "employees",
            "op": "gte",
            "value": 100
          }
        }
      ]
    }
  },
