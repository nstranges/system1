    "summary": "Allow, warn, remove or send a post to a human moderator.",
    "fit": "workable",
    "fit_reasons": [
      "High volume with a short input",
      "Four outcomes",
      "Many cases need judgment, so rules only cover the clear ones",
      "A human moderator reviews removals"
    ],
    "sample_inputs": [
      "Great tutorial, thanks for sharing!",
      "Buy cheap watches at my store, link in bio.",
      "You people are idiots and should leave this forum."
    ],
    "policy": {
      "decision_question": "What should we do with this post?",
      "question_key": "decision",
      "inputs": [
        {
          "key": "post",
          "label": "Post text",
          "type": "text",
          "description": ""
        },
        {
          "key": "prior_warnings",
          "label": "Prior warnings for the author",
          "type": "int",
          "description": ""
        },
        {
          "key": "reported_count",
          "label": "Times reported",
          "type": "int",
          "description": ""
        }
      ],
      "options": [
        {
          "key": "allow",
          "name": "Allow",
          "covers": [
            "Normal discussion"
          ],
          "excludes": [],
          "example": ""
        },
        {
          "key": "warn",
          "name": "Warn the author",
          "covers": [
            "Mild rule breaks, first offense"
          ],
          "excludes": [],
          "example": ""
        },
        {
          "key": "remove",
          "name": "Remove",
          "covers": [
            "Spam, slurs, threats"
          ],
          "excludes": [],
          "example": ""
        },
        {
          "key": "review",
          "name": "Human review",
          "covers": [
            "Borderline or heavily reported posts"
          ],
          "excludes": [],
          "example": ""
        }
      ],
      "rules": [
        {
          "id": "R1",
          "text": "Posts reported five or more times go to human review.",
          "label": "review",
          "when": {
            "field": "reported_count",
            "op": "gte",
            "value": 5
          }
        },
        {
          "id": "R2",
          "text": "Authors with three or more prior warnings have the post removed when it breaks a rule.",
          "label": "remove",
          "when": {
            "field": "prior_warnings",
            "op": "gte",
            "value": 3
          }
        },
        {
          "id": "R3",
          "text": "The post is aggressive but not threatening, so warn the author.",
          "label": "warn",
          "when": null
        }
      ]
    }
  },
  {
    "id": "bug-triage",
    "name": "Bug report triage",
    "summary": "Assign a bug report to a component and severity bucket.",
    "fit": "workable",
    "fit_reasons": [
      "Plenty of reports",
      "Fixed set of buckets",
      "Severity depends on how many users are affected, which may not be stated",
      "Engineers re-check the assignment"
    ],
    "sample_inputs": [
      "Exports silently drop the last 50 rows of every file.",
      "The settings page button label is misspelled.",
      "Search returns nothing for 300 users, no workaround known."
    ],
    "policy": {
      "decision_question": "Which bucket does this bug belong to?",
      "question_key": "decision",
      "inputs": [
        {
          "key": "report",
          "label": "Report text",
          "type": "text",
          "description": ""
        },
        {
          "key": "users_affected",
          "label": "Users affected",
          "type": "int",
          "description": ""
        },
        {
          "key": "data_loss",
          "label": "Data loss reported",
          "type": "bool",
          "description": ""
        },
        {
          "key": "has_workaround",
          "label": "Workaround exists",
          "type": "bool",
          "description": ""
        }
      ],
      "options": [
        {
          "key": "critical",
          "name": "Critical",
          "covers": [
            "Data loss",
            "Outage for many users"
          ],
          "excludes": [],
          "example": ""
        },
        {
          "key": "high",
          "name": "High",
          "covers": [
            "Core feature broken, no workaround"
          ],
          "excludes": [],
          "example": ""
        },
        {
          "key": "normal",
          "name": "Normal",
          "covers": [
            "Broken feature with a workaround"
          ],
          "excludes": [],
          "example": ""
        },
        {
          "key": "low",
          "name": "Low",
          "covers": [
            "Cosmetic issues, typos"
          ],
          "excludes": [],
          "example": ""
        }
      ],
      "rules": [
        {
          "id": "R1",
          "text": "Any data loss is critical.",
          "label": "critical",
          "when": {
            "field": "data_loss",
            "op": "eq",
            "value": true
          }
        },
        {
          "id": "R2",
          "text": "More than 100 users affected with no workaround is high.",
          "label": "high",
          "when": {
            "all": [
              {
                "field": "users_affected",
                "op": "gt",
                "value": 100
              },
              {
                "field": "has_workaround",
                "op": "eq",
                "value": false
              }
            ]
          }
        },
        {
          "id": "R3",
          "text": "Anything with a workaround is normal.",
          "label": "normal",
          "when": {
            "field": "has_workaround",
            "op": "eq",
            "value": true
          }
        }
      ]
    }
  },
