  {
    "id": "expense-check",
    "name": "Expense report check",
    "summary": "Approve an expense line, ask for a receipt, flag a policy violation or escalate.",
    "fit": "good",
    "fit_reasons": [
      "Many lines a month",
      "Four outcomes",
      "Dollar thresholds and receipt rules",
      "Finance reviews flagged lines"
    ],
    "sample_inputs": [
      "A $48 team lunch with a receipt attached.",
      "A $230 gift basket for a client, no receipt.",
      "A $3,400 conference ticket, pre-approved by the VP."
    ],
    "policy": {
      "decision_question": "What should happen to this expense?",
      "question_key": "decision",
      "inputs": [
        {
          "key": "amount",
          "label": "Amount (USD)",
          "type": "float",
          "description": ""
        },
        {
          "key": "has_receipt",
          "label": "Receipt attached",
          "type": "bool",
          "description": ""
        },
        {
          "key": "category",
          "label": "Category",
          "type": "enum",
          "description": "",
          "values": [
            "meals",
            "travel",
            "software",
            "gifts",
            "other"
          ]
        },
        {
          "key": "preapproved",
          "label": "Pre-approved",
          "type": "bool",
          "description": ""
        }
      ],
      "options": [
        {
          "key": "approve",
          "name": "Approve",
          "covers": [
            "Under $75 with a receipt",
            "Pre-approved items"
          ],
          "excludes": [],
          "example": ""
        },
        {
          "key": "needs_receipt",
          "name": "Needs receipt",
          "covers": [
            "$25 or more with no receipt"
          ],
          "excludes": [],
          "example": ""
        },
        {
          "key": "policy_violation",
          "name": "Policy violation",
          "covers": [
            "Gifts over $100",
            "Alcohol-only meals"
          ],
          "excludes": [],
          "example": ""
        },
        {
          "key": "escalate",
          "name": "Escalate to finance",
          "covers": [
            "Anything over $1,000"
          ],
          "excludes": [],
          "example": ""
        }
      ],
      "rules": [
        {
          "id": "R1",
          "text": "Anything over $1,000 goes to finance.",
          "label": "escalate",
          "when": {
            "field": "amount",
            "op": "gt",
            "value": 1000
          }
        },
        {
          "id": "R2",
          "text": "No receipt on $25 or more needs a receipt.",
          "label": "needs_receipt",
          "when": {
            "all": [
              {
                "field": "has_receipt",
                "op": "eq",
                "value": false
              },
              {
                "field": "amount",
                "op": "gte",
                "value": 25
              }
            ]
          }
        },
        {
          "id": "R3",
          "text": "Gifts over $100 are a policy violation.",
          "label": "policy_violation",
          "when": {
            "all": [
              {
                "field": "category",
                "op": "eq",
                "value": "gifts"
              },
              {
                "field": "amount",
                "op": "gt",
                "value": 100
              }
            ]
          }
        }
      ]
    }
  },
  {
    "id": "content-moderation",
