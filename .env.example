# Copy to .env (`make env`) and fill in. .env is gitignored, so never commit real keys.
# Write values unquoted, with no spaces around the equals sign.

# Jev (TypeSafe). The TypeSafe SDK reads these names directly.
TYPESAFE_API_KEY=
# Direct TypeSafe API. If your key is an OpenRouter key, use https://openrouter.ai/api instead.
TYPESAFE_BASE_URL=https://api.typesafe.ai
# Pin a versioned model for anything we report. Aliases like jev-latest move without notice.
JEV_MODEL=jev-1.13.0

# Optional: only needed if we route Jev through OpenRouter.
# OPENROUTER_API_KEY=

# Not used in phase 1 (data is written in-session). Kept for later phases.
# ANTHROPIC_API_KEY=

# Modal normally authenticates through `make modal-setup` (~/.modal.toml).
# Set these only for CI or headless machines.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
